{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ManaTTS",
  "version": "0.1.0",
  "identifier": "com.mana.tts",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "مانا — تبدیل متن به گفتار",
        "width": 880,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "تبدیل متن فارسی به گفتار، آفلاین",
    "longDescription": "ManaTTS: offline Persian text-to-speech powered by the Mana Piper voice. No internet, no accounts.",
    "resources": [
      "../models/fa_IR-mana-medium.onnx",
      "../models/fa_IR-mana-medium.onnx.json",
      "../tools/piper/piper",
      "../tools/piper/*.so*",
      "../tools/piper/espeak-ng-data",
      "../licenses"
    ]
  }
}
